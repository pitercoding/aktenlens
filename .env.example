# Copy this file to .env and replace the values. Never commit the real .env.

# --- PostgreSQL (used by compose.yaml) ---
POSTGRES_DB=aktenlens
POSTGRES_USER=aktenlens
# Generate one with: openssl rand -hex 16
# Use only letters and digits, so it can go inside DATABASE_URL without encoding.
POSTGRES_PASSWORD=change-me
# Port on your machine (5433 because 5432 may be taken by a local PostgreSQL).
POSTGRES_PORT=5433

# --- Go API and goose (Compose does not fill this one, repeat the values) ---
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=postgres://aktenlens:change-me@127.0.0.1:5433/aktenlens?sslmode=disable

# --- API behavior (read by the Go API) ---
# Session cookies are HTTPS-only by default (when unset). Running locally over
# plain HTTP needs false. NEVER set false in production.
COOKIE_SECURE=false

# Frontends on another origin that may call POST/PUT/PATCH/DELETE (comma-separated,
# "scheme://host[:port]", no path). Leave empty when the frontend is on the same origin.
# TRUSTED_ORIGINS=http://localhost:3000

# How many reverse proxies of ours sit in front of the API: 0 when running locally.
# On the host platform, check how many it adds before setting this.
TRUSTED_PROXY_HOPS=0
