# Copy this file to .env and replace the values. Never commit the real .env.

# --- PostgreSQL (used by compose.yaml) ---
POSTGRES_DB=aktenlens
POSTGRES_USER=aktenlens
# Generate one with: openssl rand -hex 16
# Use only letters and digits, so it can go inside DATABASE_URL without encoding.
POSTGRES_PASSWORD=change-me
# Port on your machine (5433 because 5432 may be taken by a local PostgreSQL).
POSTGRES_PORT=5433

# --- Go API and goose (Compose does not fill this one, repeat the values) ---
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=postgres://aktenlens:change-me@127.0.0.1:5433/aktenlens?sslmode=disable
